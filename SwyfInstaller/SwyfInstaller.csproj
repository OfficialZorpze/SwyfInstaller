<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SwyfInstaller</AssemblyName>
    <Version>1.1.7</Version>
    <Description>Console installer for SWYF Custom AI with SHA-256 verification.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\compatibility\Plugins\x86_64\steam_api64.dll">
      <Link>compatibility\Plugins\x86_64\steam_api64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
