<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SWYF.CustomAI.Bridge</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule;UnityEngine.UIElementsModule;UnityEngine.UnityWebRequestModule;Unity.InputSystem;Mirror;Newtonsoft.Json;UniTask">
      <HintPath>$(GameManaged)\\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Set SWYF_GAME_DIR or pass -p:GameDir to your game installation folder." />
  </Target>
</Project>
